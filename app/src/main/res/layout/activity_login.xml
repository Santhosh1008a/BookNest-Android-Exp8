<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app1="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_deep">

    <!-- Magic Animated Particle Background -->
    <com.example.exp5notification.ui.MagicBackgroundView
        android:id="@+id/magic_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Decorative elements -->
    <View
        android:id="@+id/circle1"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/circle_blur"
        app1:layout_constraintTop_toTopOf="parent"
        app1:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="-50dp"
        android:layout_marginStart="-50dp" />

    <View
        android:id="@+id/circle2"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="@drawable/circle_blur_alt"
        app1:layout_constraintBottom_toBottomOf="parent"
        app1:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="-80dp"
        android:layout_marginEnd="-80dp" />

    <LinearLayout
        android:id="@+id/login_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/bg_liquid_glass_card"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="32dp"
        app1:layout_constraintBottom_toBottomOf="parent"
        app1:layout_constraintEnd_toEndOf="parent"
        app1:layout_constraintStart_toStartOf="parent"
        app1:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_book"
            app1:tint="@color/soft_cyan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:text="BookNest"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Digital Library Sanctuary"
            android:textColor="@color/white_60"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_neomorph_input"
            android:padding="18dp"
            android:hint="Name"
            android:textColor="@color/white"
            android:textColorHint="@color/white_60"
            android:inputType="textPersonName"
            android:text="Sandy" />

        <EditText
            android:id="@+id/et_usn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_neomorph_input"
            android:padding="18dp"
            android:hint="USN"
            android:textColor="@color/white"
            android:textColorHint="@color/white_60"
            android:inputType="text"
            android:text="25MCAR0133" />

        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_neomorph_button"
            android:text="Enter Library"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="false"
            android:textSize="18sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
