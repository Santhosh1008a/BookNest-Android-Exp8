<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_deep">

    <!-- Magic Animated Particle Background -->
    <com.example.exp5notification.ui.MagicBackgroundView
        android:id="@+id/magic_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="48dp">

        <!-- ═══════════════════════════════════ -->
        <!-- HEADER BAR                          -->
        <!-- ═══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="16dp">

            <ImageButton
                android:id="@+id/btn_settings_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="Settings"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <!-- Spacer to balance back button -->
            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- ═══════════════════════════════════ -->
        <!-- USER PROFILE CARD                   -->
        <!-- ═══════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_liquid_glass_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <!-- Profile Icon -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_user"
                app:tint="@color/soft_cyan" />

            <!-- User Name TextView -->
            <TextView
                android:id="@+id/tv_settings_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-black"
                android:text="Sandy"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <!-- USN TextView -->
            <TextView
                android:id="@+id/tv_settings_usn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="USN: 25MCAR0133"
                android:textColor="@color/soft_cyan"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ═══════════════════════════════════ -->
        <!-- USER SETTINGS SECTION              -->
        <!-- ═══════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="USER SETTINGS"
            android:textAllCaps="true"
            android:textColor="@color/white_60"
            android:textSize="11sp"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_section_card"
            android:orientation="vertical"
            android:padding="4dp">

            <!-- Setting 1: Notifications (Switch) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_book"
                    app:tint="@color/sky_blue" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Notifications"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/switch_notifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="@color/soft_cyan"
                    android:trackTint="@color/navy_light"
                    android:showText="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/white_10" />

            <!-- Setting 2: Dark Mode (Switch) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_book"
                    app:tint="@color/fantasy_purple" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Dark Mode"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/switch_dark_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:thumbTint="@color/soft_cyan"
                    android:trackTint="@color/navy_light"
                    android:showText="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="@color/white_10" />

            <!-- Setting 3: Reading Reminders (Switch) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/mystery_amber" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Reading Reminders"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <Switch
                    android:id="@+id/switch_reading_reminders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="@color/soft_cyan"
                    android:trackTint="@color/navy_light"
                    android:showText="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- Settings Status Summary -->
        <TextView
            android:id="@+id/tv_settings_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_section_card"
            android:padding="16dp"
            android:text="Notifications: ON  •  Dark Mode: OFF  •  Reminders: ON"
            android:textColor="@color/white_60"
            android:textSize="12sp"
            android:gravity="center" />

        <!-- ═══════════════════════════════════ -->
        <!-- ABOUT SECTION                       -->
        <!-- ═══════════════════════════════════ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="ABOUT"
            android:textAllCaps="true"
            android:textColor="@color/white_60"
            android:textSize="11sp"
            android:letterSpacing="0.12" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_section_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_book"
                app:tint="@color/soft_cyan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:text="BookNest"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Experiment 5 + 6  •  Android Lab"
                android:textColor="@color/white_60"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ═══════════════════════════════════ -->
        <!-- LOGOUT BUTTON                       -->
        <!-- ═══════════════════════════════════ -->
        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_logout_button"
            android:fontFamily="sans-serif-black"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="@color/romance_coral"
            android:textSize="17sp" />

    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
