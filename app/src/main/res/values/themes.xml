<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Light Mode. -->
    <style name="Base.Theme.BookNest" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colors. -->
        <item name="colorPrimary">@color/royal_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sky_blue</item>
        <item name="android:windowBackground">#F1F5F9</item>
        <item name="android:statusBarColor">#1E293B</item>
        <item name="android:navigationBarColor">#F1F5F9</item>
    </style>

    <style name="Theme.BookNest" parent="Base.Theme.BookNest" />

    <!-- Glassmorphism Styles -->
    <style name="GlassCard">
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="android:elevation">8dp</item>
    </style>

    <style name="GlassButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_glass_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="GlassInput">
        <item name="android:background">@drawable/bg_glass_input</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/white_60</item>
    </style>
</resources>
